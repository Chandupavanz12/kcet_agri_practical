# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Example (Atlas): mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# dedicated cluster for GridFS files (optional, prevents storage limit exhaustion)
MONGO_URI_FILES=

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Single Admin seed (created on server start if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# PostgreSQL (Neon Serverless Postgres for Multi-Exam Hubs)
# Example: postgresql://<user>:<password>@<host>/<database>?sslmode=require
PUC_DATABASE_URL=
KCET_NEET_DATABASE_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Uploads (local)
UPLOAD_PROVIDER=local
